<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Thống kê đoàn viên</title>
<style>
:root{--bg:#eef3f8;--card:#fff;--ink:#14263d;--mut:#5d6f84;--line:#d6e0ea;--pri:#0b5cad;--pri2:#084a8c;--ok:#1b7f4b;--warn:#b26a00;--bad:#b3261e}
*{box-sizing:border-box}
body{margin:0;font-family:"Segoe UI",system-ui,sans-serif;background:var(--bg);color:var(--ink);line-height:1.5}
header{background:var(--pri);color:#fff;padding:14px 20px;display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between}
header h1{font-size:1.15rem;margin:0}
nav{display:flex;gap:6px}
nav button{background:transparent;color:#fff;border:1px solid rgba(255,255,255,.5);padding:8px 14px;border-radius:6px;cursor:pointer;font-size:.95rem}
nav button.on{background:#fff;color:var(--pri);font-weight:600}
main{max-width:1000px;margin:24px auto;padding:0 16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:24px}
.narrow{max-width:460px;margin:0 auto}
h2{margin:0 0 16px;font-size:1.25rem}
label{display:block;font-weight:600;margin:14px 0 4px;font-size:.95rem}
input,select{width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:6px;font:inherit;background:#fff}
input:focus,select:focus,button:focus-visible{outline:2px solid var(--pri);outline-offset:1px}
.btn{background:var(--pri);color:#fff;border:0;padding:10px 18px;border-radius:6px;font:inherit;font-weight:600;cursor:pointer}
.btn:hover{background:var(--pri2)}
.btn.sec{background:#fff;color:var(--pri);border:1px solid var(--pri)}
.btn.sm{padding:5px 10px;font-size:.85rem}
.btn.ok{background:var(--ok)}.btn.bad{background:var(--bad)}
.full{width:100%;margin-top:20px}
.msg{margin-top:14px;padding:10px 12px;border-radius:6px;font-size:.93rem;display:none}
.msg.ok{display:block;background:#e3f4ea;color:var(--ok)}
.msg.err{display:block;background:#fbe7e5;color:var(--bad)}
.bar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;margin-bottom:14px}
.bar .grp{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.bar input{width:220px}.bar select{width:auto}
.stats{color:var(--mut);font-size:.93rem}
.wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:.93rem}
th,td{padding:9px 10px;border-bottom:1px solid var(--line);text-align:left;white-space:nowrap}
th{background:#f3f7fb}
.tag{padding:2px 9px;border-radius:99px;font-size:.8rem;font-weight:600}
.tag.pending{background:#fff1d9;color:var(--warn)}.tag.approved{background:#dff3e7;color:var(--ok)}
td.act{display:flex;gap:5px}
dialog{border:0;border-radius:10px;padding:24px;width:min(420px,92vw)}
dialog::backdrop{background:rgba(10,25,45,.5)}
.row{display:flex;gap:8px;justify-content:flex-end;margin-top:20px}
.hide{display:none!important}
.printhead{display:none}
@media print{
  header,.bar,.act-col,td.act,#view-form,#view-login,dialog,.msg{display:none!important}
  body{background:#fff}.card{border:0;padding:0}
  .printhead{display:block;text-align:center;margin-bottom:12px}
  th,td{font-size:11pt;white-space:normal}
}
</style>
</head>
<body>
<header>
  <h1>Thống kê đoàn viên</h1>
  <nav>
    <button id="tab-form" class="on">Nhập thông tin</button>
    <button id="tab-admin">Quản trị</button>
  </nav>
</header>
<main>

<!-- Form nhập -->
<section id="view-form" class="card narrow">
  <h2>Khai báo thông tin đoàn viên</h2>
  <form id="memberForm">
    <label for="name">Họ và tên</label>
    <input id="name" required maxlength="80" autocomplete="name">
    <label for="dob">Ngày tháng năm sinh</label>
    <input id="dob" type="date" required>
    <label for="join">Ngày vào Đoàn</label>
    <input id="join" type="date" required>
    <button class="btn full" type="submit">Gửi thông tin</button>
  </form>
  <div id="formMsg" class="msg"></div>
</section>

<!-- Đăng nhập admin -->
<section id="view-login" class="card narrow hide">
  <h2>Đăng nhập quản trị</h2>
  <form id="loginForm">
    <label for="email">Email</label>
    <input id="email" type="email" required autocomplete="username">
    <label for="pass">Mật khẩu</label>
    <input id="pass" type="password" required autocomplete="current-password">
    <button class="btn full" type="submit">Đăng nhập</button>
  </form>
  <div id="loginMsg" class="msg"></div>
</section>

<!-- Bảng admin -->
<section id="view-admin" class="card hide">
  <div class="printhead">
    <h2>DANH SÁCH ĐOÀN VIÊN</h2>
    <div id="printDate"></div>
  </div>
  <div class="bar">
    <div class="grp">
      <input id="search" placeholder="Tìm theo họ tên…" aria-label="Tìm theo họ tên">
      <select id="filter" aria-label="Lọc trạng thái">
        <option value="all">Tất cả</option>
        <option value="pending">Chờ duyệt</option>
        <option value="approved">Đã duyệt</option>
      </select>
    </div>
    <div class="grp">
      <span id="stats" class="stats"></span>
      <button id="pdfBtn" class="btn sec">Xuất PDF</button>
      <button id="logoutBtn" class="btn sec">Đăng xuất</button>
    </div>
  </div>
  <div class="wrap">
    <table>
      <thead><tr><th>STT</th><th>Họ và tên</th><th>Ngày sinh</th><th>Ngày vào Đoàn</th><th>Trạng thái</th><th class="act-col">Thao tác</th></tr></thead>
      <tbody id="tbody"></tbody>
    </table>
  </div>
  <div id="adminMsg" class="msg"></div>
</section>
</main>

<!-- Hộp thoại sửa -->
<dialog id="editDlg">
  <h2>Sửa thông tin đoàn viên</h2>
  <form id="editForm">
    <label for="eName">Họ và tên</label><input id="eName" required>
    <label for="eDob">Ngày tháng năm sinh</label><input id="eDob" type="date" required>
    <label for="eJoin">Ngày vào Đoàn</label><input id="eJoin" type="date" required>
    <label for="eStatus">Trạng thái</label>
    <select id="eStatus"><option value="pending">Chờ duyệt</option><option value="approved">Đã duyệt</option></select>
    <div class="row">
      <button type="button" class="btn sec" id="eCancel">Hủy</button>
      <button type="submit" class="btn">Lưu thay đổi</button>
    </div>
  </form>
</dialog>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { getDatabase, ref, push, set, update, remove, onValue, off } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-database.js";
import { getAuth, signInWithEmailAndPassword, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";

const firebaseConfig = {
  apiKey: "AIzaSyDtAU-Iqn-u39_mgkxRZ3fIF_Kyxqn-Gyg",
  authDomain: "csdl-bio.firebaseapp.com",
  databaseURL: "https://csdl-bio-default-rtdb.firebaseio.com",
  projectId: "csdl-bio",
  storageBucket: "csdl-bio.firebasestorage.app",
  messagingSenderId: "568258817515",
  appId: "1:568258817515:web:9063f9ac685648aca63dae",
  measurementId: "G-0TSQN84XXE"
};
const app = initializeApp(firebaseConfig);
const db = getDatabase(app);
const auth = getAuth(app);
const membersRef = ref(db, "members");

const $ = id => document.getElementById(id);
const fmt = d => d ? d.split("-").reverse().join("/") : "";
const esc = s => String(s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
function say(el, text, ok = true){ el.textContent = text; el.className = "msg " + (ok ? "ok" : "err"); }

let data = [], user = null, editId = null, listening = false;

/* Chuyển tab */
function show(view){
  ["form","login","admin"].forEach(v => $("view-"+v).classList.toggle("hide", v !== view));
  $("tab-form").classList.toggle("on", view === "form");
  $("tab-admin").classList.toggle("on", view !== "form");
}
$("tab-form").onclick = () => show("form");
$("tab-admin").onclick = () => show(user ? "admin" : "login");

/* Gửi thông tin */
$("memberForm").addEventListener("submit", async e => {
  e.preventDefault();
  const name = $("name").value.trim(), dob = $("dob").value, join = $("join").value;
  if (join < dob) return say($("formMsg"), "Ngày vào Đoàn không thể trước ngày sinh.", false);
  try {
    await set(push(membersRef), { name, dob, join, status: "pending", createdAt: Date.now() });
    e.target.reset();
    say($("formMsg"), "Đã gửi thông tin. Thông tin đang chờ quản trị viên duyệt.");
  } catch (err) {
    say($("formMsg"), "Không gửi được: " + err.message, false);
  }
});

/* Đăng nhập / đăng xuất */
$("loginForm").addEventListener("submit", async e => {
  e.preventDefault();
  try {
    await signInWithEmailAndPassword(auth, $("email").value.trim(), $("pass").value);
    $("loginForm").reset(); $("loginMsg").className = "msg";
  } catch (err) {
    say($("loginMsg"), "Email hoặc mật khẩu không đúng.", false);
  }
});
$("logoutBtn").onclick = () => signOut(auth);

onAuthStateChanged(auth, u => {
  user = u;
  if (u){
    show("admin");
    if (!listening){
      listening = true;
      onValue(membersRef, snap => {
        const v = snap.val() || {};
        data = Object.entries(v).map(([id, m]) => ({ id, ...m })).sort((a, b) => (a.createdAt || 0) - (b.createdAt || 0));
        render();
      }, err => say($("adminMsg"), "Không đọc được dữ liệu: " + err.message, false));
    }
  } else {
    if (listening){ off(membersRef); listening = false; }
    data = []; render();
    if (!$("view-form").classList.contains("hide")) return;
    show("login");
  }
});

/* Bảng dữ liệu */
function render(){
  const q = $("search").value.trim().toLowerCase(), f = $("filter").value;
  const rows = data.filter(m => (f === "all" || m.status === f) && m.name.toLowerCase().includes(q));
  const done = data.filter(m => m.status === "approved").length;
  $("stats").textContent = `${data.length} đoàn viên · ${done} đã duyệt · ${data.length - done} chờ duyệt`;
  $("tbody").innerHTML = rows.length ? rows.map((m, i) => `
    <tr>
      <td>${i + 1}</td><td>${esc(m.name)}</td><td>${fmt(m.dob)}</td><td>${fmt(m.join)}</td>
      <td><span class="tag ${m.status}">${m.status === "approved" ? "Đã duyệt" : "Chờ duyệt"}</span></td>
      <td class="act">
        ${m.status !== "approved" ? `<button class="btn sm ok" data-a="approve" data-id="${m.id}">Duyệt</button>` : `<button class="btn sm sec" data-a="unapprove" data-id="${m.id}">Bỏ duyệt</button>`}
        <button class="btn sm sec" data-a="edit" data-id="${m.id}">Sửa</button>
        <button class="btn sm bad" data-a="del" data-id="${m.id}">Xóa</button>
      </td>
    </tr>`).join("") : `<tr><td colspan="6">Chưa có đoàn viên nào phù hợp.</td></tr>`;
}
$("search").oninput = render;
$("filter").onchange = render;

$("tbody").addEventListener("click", async e => {
  const b = e.target.closest("button[data-a]"); if (!b) return;
  const id = b.dataset.id, m = data.find(x => x.id === id), act = b.dataset.a;
  try {
    if (act === "approve") await update(ref(db, "members/" + id), { status: "approved" });
    if (act === "unapprove") await update(ref(db, "members/" + id), { status: "pending" });
    if (act === "del" && confirm(`Xóa đoàn viên "${m.name}"?`)) await remove(ref(db, "members/" + id));
    if (act === "edit"){
      editId = id;
      $("eName").value = m.name; $("eDob").value = m.dob; $("eJoin").value = m.join; $("eStatus").value = m.status;
      $("editDlg").showModal();
    }
  } catch (err) { say($("adminMsg"), "Thao tác thất bại: " + err.message, false); }
});

$("eCancel").onclick = () => $("editDlg").close();
$("editForm").addEventListener("submit", async e => {
  e.preventDefault();
  const dob = $("eDob").value, join = $("eJoin").value;
  if (join < dob) return alert("Ngày vào Đoàn không thể trước ngày sinh.");
  try {
    await update(ref(db, "members/" + editId), { name: $("eName").value.trim(), dob, join, status: $("eStatus").value });
    $("editDlg").close();
    say($("adminMsg"), "Đã lưu thay đổi.");
  } catch (err) { say($("adminMsg"), "Không lưu được: " + err.message, false); }
});

/* Xuất PDF: dùng hộp thoại in của trình duyệt (chọn "Lưu dưới dạng PDF"), hiển thị đúng tiếng Việt */
$("pdfBtn").onclick = () => {
  $("printDate").textContent = "Ngày xuất: " + new Date().toLocaleDateString("vi-VN");
  window.print();
};
</script>
</body>
</html>
